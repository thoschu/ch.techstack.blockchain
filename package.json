{
  "name": "ch.techstack.blockchain",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "ci": "npm ci",
    "start": "node build/index.js",
    "dev": "npx concurrently \"npm run dev:1\" \"npm run dev:2\" \"npm run dev:3\"",
    "dev:0": "PORT=3000 nodemon -r tsconfig-paths/register ./index.ts",
    "dev:1": "PORT=3001 nodemon -r tsconfig-paths/register ./index.ts",
    "dev:2": "PORT=3002 nodemon -r tsconfig-paths/register ./index.ts",
    "dev:3": "PORT=3003 nodemon -r tsconfig-paths/register ./index.ts",
    "dev:inspect": "nodemon --inspect ./index.ts",
    "test": "jest",
    "lint": "gts lint",
    "clean": "gts clean",
    "compile": "tsc",
    "compile:w": "tsc -w",
    "fix": "gts fix",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "posttest": "npm run lint",
    "rimraf": "npx rimraf build",
    "ngrok": "npx ngrok http 3000",
    "explorer": "echo \"Info: you have to setup e.g. mkcert \" && npx http-server ./src/explorer/i -S true -C ./example.com+5.pem -K ./example.com+5-key.pem",
    "wallet": "echo \"Info: you have to setup e.g. mkcert \" && npx http-server ./etherwallet-v3.40.0 -S true -C ./example.com+5.pem -K ./example.com+5-key.pem"
  },
  "author": "Tom S.",
  "license": "ISC",
  "description": "blockchain node.js typescript",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.15.3",
    "@types/axios": "^0.14.4",
    "@types/express": "^5.0.0",
    "@types/express-status-monitor": "^1.3.3",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@types/ramda": "^0.30.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.12.2",
    "concurrently": "^9.1.0",
    "gts": "^6.0.2",
    "jest": "^29.7.0",
    "jest-module-name-mapper": "^0.1.5",
    "nodemon": "^3.1.9",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "validator": "^13.12.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-status-monitor": "^1.3.4",
    "express-winston": "^4.2.0",
    "luxon": "^3.5.0",
    "ramda": "^0.30.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.3",
    "winston": "^3.17.0"
  }
}
