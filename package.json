{
  "name": "ch.techstack.blockchain",
  "version": "1.0.0",
  "main": "index.js",
  "keywords": [
    "nodejs",
    "bootstrap",
    "express"
  ],
  "_moduleAliases": {
    "@app/*": "build/src/*",
    "@app/main": "build/src/main",
    "@blockchain/blockchain.class": "build/src/blockchain/blockchain.class",
    "@blockchain/block/block.class": "build/src/blockchain/block/block.class",
    "@blockchain/transaction/transaction.class": "build/src/blockchain/transaction/transaction.class",
    "@api/api-v3/swagger": "build/src/open-api/api-v3/swagger",
    "@routes/get.routes": "build/src/routes/get.routes",
    "@routes/post.routes": "build/src/routes/post.routes",
    "@explorer/index.html": "build/src/explorer/index.html"
  },
  "scripts": {
    "i": "npm install",
    "ci": "npm ci",
    "start": "node build/index.js",
    "dev": "npx concurrently \"npm run dev:0\" \"npm run dev:1\" 'npm run dev:2' 'npm run dev:3'",
    "dev:0": "PORT=3000 nodemon -r tsconfig-paths/register ./index.ts",
    "dev:1": "PORT=3001 nodemon -r tsconfig-paths/register ./index.ts",
    "dev:2": "PORT=3002 nodemon -r tsconfig-paths/register ./index.ts",
    "dev:3": "PORT=3003 nodemon -r tsconfig-paths/register ./index.ts",
    "test": "jest",
    "lint": "",
    "lint:dev": "gts lint ./src/**/*.ts",
    "clean": "gts clean",
    "compile": "tsc -b && npm run copy-files",
    "compile:d": "npx rimraf build && tsc -b && npm run copy-files",
    "compile:w": "tsc -w && npm run copy-files",
    "copy-files": "cp ./src/explorer/index.html ./build/src/",
    "fix": "gts fix",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "posttest": "npm run lint",
    "rimraf": "npx rimraf build",
    "ngrok": "npx ngrok http 3000",
    "explorer": "echo \"Info: you have to setup e.g. mkcert \" && npx http-server ./src/explorer/i -S true -C ./example.com+5.pem -K ./example.com+5-key.pem",
    "wallet": "echo \"Info: you have to setup e.g. mkcert \" && npx http-server ./etherwallet-v3.40.0 -S true -C ./example.com+5.pem -K ./example.com+5-key.pem",
    "docker:build": "docker build -t thoschu/blockchain .",
    "docker:build:x": "docker buildx build --platform linux/amd64,linux/arm64 -t thoschu/blockchain .",
    "docker:run": "docker run --name blockchain -p 4000:4000 thoschu/blockchain",
    "docker:compose:up:d": "docker compose -p techstack up -d",
    "docker:compose:down": "docker compose down",
    "clean:node_modules": "npx rimraf node_modules",
    "dev:connect:node:1": "curl -X POST -H \"Content-Type: application/json\" -d '{\"node\": \"http://0.0.0.0:3001\"}' http://localhost:3000/api/v3/register-broadcast-node",
    "dev:connect:node:2": "curl -X POST -H \"Content-Type: application/json\" -d '{\"node\": \"http://0.0.0.0:3002\"}' http://localhost:3000/api/v3/register-broadcast-node",
    "dev:connect:node:3": "curl -X POST -H \"Content-Type: application/json\" -d '{\"node\": \"http://0.0.0.0:3003\"}' http://localhost:3000/api/v3/register-broadcast-node",
    "dev:connect": "concurrently \"npm run dev:connect:node:1\" \"npm run dev:connect:node:2\""
  },
  "author": "Tom S.",
  "license": "MIT",
  "description": "blockchain node.js typescript",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.15.3",
    "@types/axios": "^0.14.4",
    "@types/express": "^5.0.0",
    "@types/express-status-monitor": "^1.3.3",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.4.2",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^22.10.2",
    "@types/ramda": "^0.30.2",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.12.2",
    "concurrently": "^9.1.0",
    "gts": "^6.0.2",
    "jest": "^29.7.0",
    "jest-module-name-mapper": "^0.1.5",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "validator": "^13.12.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-status-monitor": "^1.3.4",
    "express-winston": "^4.2.0",
    "luxon": "^3.5.0",
    "module-alias": "^2.2.3",
    "ramda": "^0.30.1",
    "rxjs": "^7.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.19.2",
    "uuid": "^11.0.3",
    "winston": "^3.17.0"
  }
}
