{
  "compilerOptions": {
    "types": ["node", "jest", "express"],
    "target": "es6",
    "lib": ["es2016"],
    "module": "commonjs",
    "rootDir": ".",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/*"],
      "@blockchain/*": ["src/blockchain/*"],
      "@api/*": ["src/open-api/*"],
      "@routes/*": ["src/routes/*"]
    },
    "sourceMap": true,
    "outDir": "./build",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "index.ts"],
  "exclude": ["node_modules"]
}
